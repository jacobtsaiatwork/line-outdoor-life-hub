# LINE Official Account Messaging API 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Google Maps Places API 金鑰 (選填，未設定時自動啟用智慧離線雷達與 Google Maps URI 導航)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API 金鑰 (選填，用於拍照食物辨識與自然語言營養分析；未設定時自動使用內建台灣外食詞庫)
GEMINI_API_KEY=your_gemini_api_key_here

# 資料庫設定 (選填，未設定時預設使用本地 SQLite `outdoor_hub.db`)
SUPABASE_DB_URL=

# LINE LIFF 應用設定 (選填，若有在 LINE Developers Console 建立 LIFF 應用可填入對應 LIFF ID)
LIFF_ID_DASHBOARD=
LIFF_ID_MAP=

